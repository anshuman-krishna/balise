{
  "name": "@balise/criteria-engine",
  "version": "0.1.0",
  "description": "Referential-agnostic rule evaluation. Loads a rule pack, answers what it can, and says what it cannot.",
  "keywords": [
    "rgesn",
    "rgaa",
    "referential",
    "conformity",
    "ecodesign",
    "compliance"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anshuman-krishna/balise.git",
    "directory": "packages/criteria-engine"
  },
  "homepage": "https://github.com/anshuman-krishna/balise/tree/main/packages/criteria-engine#readme",
  "bugs": {
    "url": "https://github.com/anshuman-krishna/balise/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@balise/schemas": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
