{
  "name": "@balise/carbon-models",
  "version": "0.1.0",
  "description": "Pluggable, versioned carbon estimation models for web measurement. Models disagree; that is the point. They are never averaged.",
  "keywords": [
    "carbon",
    "ecoindex",
    "sustainable-web-design",
    "gco2e",
    "ecodesign",
    "grid-intensity"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anshuman-krishna/balise.git",
    "directory": "packages/carbon-models"
  },
  "homepage": "https://github.com/anshuman-krishna/balise/tree/main/packages/carbon-models#readme",
  "bugs": {
    "url": "https://github.com/anshuman-krishna/balise/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@balise/schemas": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
