{
  "name": "@balise/measure-core",
  "version": "0.1.0",
  "description": "Metric extraction, robust statistics, noise floor and delta classification for reproducible web measurement. Pure functions, no IO.",
  "keywords": [
    "web-measurement",
    "ecodesign",
    "statistics",
    "noise-floor",
    "median",
    "reproducibility",
    "ecoindex"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anshuman-krishna/balise.git",
    "directory": "packages/measure-core"
  },
  "homepage": "https://github.com/anshuman-krishna/balise/tree/main/packages/measure-core#readme",
  "bugs": {
    "url": "https://github.com/anshuman-krishna/balise/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@balise/schemas": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
