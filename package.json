{
  "name": "balise",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "check:packages": "node scripts/check-package-surface.mjs",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "runner:local": "pnpm --filter @balise/runner measure",
    "test:repro": "pnpm --filter @balise/runner test:repro",
    "gen:measurement-canon": "node --experimental-strip-types --import ./scripts/ts-loader.mjs apps/web/scripts/generate-measurement-canon.ts",
    "gen:ledger-canon": "node --experimental-strip-types --import ./scripts/ts-loader.mjs apps/web/scripts/generate-ledger-canon.ts",
    "gen:attribution-canon": "node --experimental-strip-types --import ./scripts/ts-loader.mjs apps/web/scripts/generate-attribution-canon.ts",
    "gen:budget-canon": "node --experimental-strip-types --import ./scripts/ts-loader.mjs apps/web/scripts/generate-budget-canon.ts",
    "gen:carbon-canon": "node --experimental-strip-types --import ./scripts/ts-loader.mjs apps/web/scripts/generate-carbon-canon.ts",
    "gen:findings-canon": "node --experimental-strip-types --import ./scripts/ts-loader.mjs apps/web/scripts/generate-findings-canon.ts",
    "gen:criteria-canon": "node --experimental-strip-types --import ./scripts/ts-loader.mjs apps/web/scripts/generate-criteria-canon.ts",
    "gen:corpus-canon": "node --experimental-strip-types --import ./scripts/ts-loader.mjs apps/web/scripts/generate-corpus-canon.ts",
    "gen:engagement-canon": "node --experimental-strip-types --import ./scripts/ts-loader.mjs apps/web/scripts/generate-engagement-canon.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "turbo": "^2.5.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.44.0"
  }
}
